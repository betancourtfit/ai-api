# Dependencies installed by bun install — not needed in build context
node_modules/

# Compiled output artifacts
dist/

# Git history — large and unused in image
.git/

# GSD planning artifacts — not needed in image
.planning/

# Local environment files — must NEVER be in the image
.env
.env.local

# Any local whisper.cpp source checkout (can be large)
whisper.cpp/

# Models now live in the runtime volume, provisioned by ensure-model.sh
# (quick task 260724-mv1) — not baked into the image. Without this rule a
# local build on a machine that happens to have ggml-tiny.bin on disk would
# silently re-fatten the image and make the CI size gate host-dependent.
# whisper-models/ itself stays out of this rule: sample.wav is tracked and
# harmless in the build context.
whisper-models/*.bin

# OS and editor cruft
.DS_Store
*.swp
*.swo
.idea/
.vscode/
